# === Routing OCPP ===
# PRIMARY : CSMS dont les réponses sont renvoyées au chargeur (obligatoire)
OCPP_UPSTREAM_PRIMARY=ws://your-csms.example.com/
# SECONDARY : CSMS miroir — reçoit tout, ses réponses sont ignorées (optionnel)
OCPP_UPSTREAM_SECONDARY=

# === Proxy / Dashboard ===
PROXY_PORT=9000
DASHBOARD_PORT=3000
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme

# === Logs ===
LOG_LEVEL=info

# === Notifications email ===
# La config de connexion SMTP (host, port, tls…) reste dans config.json
NOTIFY_EMAIL_ENABLED=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ocpp@example.com
SMTP_TO=admin@example.com

# === Notifications Pushover ===
NOTIFY_PUSHOVER_ENABLED=false
NOTIFY_PUSHOVER_TOKEN=
NOTIFY_PUSHOVER_USER=
